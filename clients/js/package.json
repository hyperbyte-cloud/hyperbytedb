{
  "name": "hyperbytedb",
  "version": "0.9.3-beta",
  "description": "Client for HyperbyteDB's InfluxDB v1 API, for Node.js and browsers",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
